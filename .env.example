# Neon PostgreSQL (Vercel integration)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Resend — emails transactionnels
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="Compta Soft <support@comptasoftmaroc.com>"

# URL publique du site (liens dans les emails)
NEXT_PUBLIC_SITE_URL="https://comptasoftmaroc.com"

# Secret JWT session admin (générer une chaîne aléatoire longue)
ADMIN_SESSION_SECRET="changez-moi-en-production"

# Création admin : npm run admin:create
ADMIN_EMAIL="admin@comptasoft.ma"
ADMIN_PASSWORD="mot-de-passe-securise"

# Codes clients licenciés autorisés à ouvrir un ticket (séparés par des virgules)
VALID_CLIENT_CODES="HEBERSOFT,GBS"
